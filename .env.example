NODE_ENV=production
PORT=3000
DATA_DIR=/data

# Required in production: obtain the secret from the hCaptcha dashboard.
HCAPTCHA_SITE_KEY=bbaee838-b0ee-4376-bf5c-206ed8ae50fa
HCAPTCHA_SECRET=

# Optional: comma-separated, confirmed IP addresses only.
BLOCKED_IPS=

# CMS and subscriber dashboard. Use long, unique production secrets.
ADMIN_EMAIL=attorney@awadlaw.com
ADMIN_PASSWORD=
SESSION_SECRET=
CMS_BASE_PATH=/firm-content-center
# Production CMS database. Keep the authentication token secret.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# JSON storage below DATA_DIR/cms is used only when Turso is not configured.

# Existing lead-delivery settings.
WEB3FORMS_ACCESS_KEY=
ALLOWED_ORIGINS=https://theawadlawfirm.com,https://www.theawadlawfirm.com
